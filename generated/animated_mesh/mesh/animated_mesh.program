            .{type_name = "vec2", shader_name = "second_offset", value_expression = "ctx.second_offset", group_index = 0},
            .{type_name = "float", shader_name = "frame_mix", value_expression = "ctx.frame_mix", group_index = 0},
            .{type_name = "vec3", shader_name = "eye", value_expression = "ctx.eye", group_index = 0},
            .{type_name = "vec3", shader_name = "direction", value_expression = "ctx.direction", group_index = 0},
            .{type_name = "bool", shader_name = "orthographic", value_expression = "ctx.orthographic", group_index = 0},
            .{type_name = "bool", shader_name = "volume", value_expression = "ctx.volume", group_index = 0},
            .{type_name = "bool", shader_name = "blend_axis_stacks", value_expression = "ctx.blend_axis_stacks", group_index = 0},
